# Apex Velo Lab - local settings. Copy this file to .env and fill in your key.
# .env is read only by the local server on this computer; the browser never sees it.

# AI Coach keys - add one or both. You pick Claude or Gemini in the app (AI Coach > AI engine).
# Anthropic API key (https://platform.claude.com/settings/keys)
ANTHROPIC_API_KEY=
# Google Gemini API key (https://aistudio.google.com/apikey)
GEMINI_API_KEY=

# Default provider when the app has no choice saved: claude or gemini
# (empty = Claude if its key is set, otherwise Gemini)
APEX_COACH_PROVIDER=

# Claude model: claude-opus-5-5 (default), claude-sonnet-5 or claude-haiku-4-5-20251001
APEX_COACH_MODEL=claude-opus-5-5

# Gemini model: gemini-3.8-flash (default), gemini-3.1-pro-preview or gemini-3.1-flash-lite
APEX_GEMINI_MODEL=gemini-3.8-flash

# Reasoning effort: low (default), medium or high (Opus / Sonnet effort; Gemini thinking level)
APEX_COACH_EFFORT=low

# Port for http://localhost:<APEX_PORT>. Keep 8080: the browser stores your rides per address.
APEX_PORT=8080

# Strava (optional) - lets you send finished rides to Strava with one button.
# Create a personal app at https://www.strava.com/settings/api
# (Authorization Callback Domain: localhost) and paste its Client ID and Client Secret here.
STRAVA_CLIENT_ID=
STRAVA_CLIENT_SECRET=
