<?xml version="1.0" encoding="utf-8"?>
<!-- Android 11 and older (android:fullBackupContent). Rides, profiles and settings ride along with
     Android Auto Backup; the Capacitor Preferences file holding sign-ins and API keys does not. -->
<full-backup-content>
    <exclude domain="sharedpref" path="CapacitorStorage.xml" />
</full-backup-content>
