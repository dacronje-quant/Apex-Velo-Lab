{
  "name": "apex-velo-mobile",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "description": "Android app (Capacitor) proof of concept for Apex Velo Lab",
  "scripts": {
    "build": "node scripts/build-web.cjs",
    "sync": "node scripts/build-web.cjs && cap sync android",
    "apk": "node scripts/build-web.cjs && cap sync android && cd android && ./gradlew assembleDebug",
    "test": "node --test \"tests/*.test.mjs\"",
    "test:browser": "node scripts/build-web.cjs && node tests/native-browser.cjs"
  },
  "dependencies": {
    "@capacitor-community/bluetooth-le": "^8.3.0",
    "@capacitor-community/keep-awake": "^8.0.1",
    "@capacitor-community/sqlite": "^8.1.1",
    "@capacitor/android": "^8.5.3",
    "@capacitor/app": "^8.1.2",
    "@capacitor/browser": "^8.0.5",
    "@capacitor/core": "^8.5.3",
    "@capacitor/filesystem": "^8.1.5",
    "@capacitor/preferences": "^8.0.1",
    "@capacitor/share": "^8.0.3"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.5.3",
    "esbuild": "^0.28.2",
    "playwright": "^1.62.1"
  },
  "type": "module",
  "engines": {
    "node": ">=22"
  }
}
