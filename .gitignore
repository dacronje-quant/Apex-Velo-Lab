# Secrets - never commit
.env
.env.*
!.env.example

# Strava tokens (written by the local server after "Connect Strava")
.strava-tokens.json

# Personal ride history (kept on this PC only - the app works without it)
data/divan_cycling_history.js
data/divan_cycling_history.json
data/*.fit

# Automatic history backups (written by the local server after rides)
data/backups/

# Apple Health (Health Auto Export): token and incoming payloads - personal data, never committed
data/health/
data/*history*

# Local backups / OS clutter
*_backup*/
Thumbs.db
desktop.ini

# Screenshots written by the browser test scripts in tests/
test-output/
